# Arquivos de workspace (causam a maioria dos conflitos)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Cache e logs
.obsidian/cache/
.obsidian/indexed-db/
*.log

# Caso você use plugins que geram arquivos temporários
.obsidian/plugins/*/data.json
# Nota: Alguns usuários preferem SINCRONIZAR as configurações dos plugins. 
# Se você quer a mesma configuração em todo lugar, remova a linha acima.

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db

# Compilados C
*.exe
*.o
*.out
a.out

# Compilados Java
*.class

# Arquivos temporários de editores
*.swp
*.swo
*~

# Arquivos de build
build/
bin/
target/

# Dependências do Node.js (O maior vilão do peso)
node_modules/
/.pnp
.pnp.js

# Arquivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variáveis de ambiente (Segurança máxima, NUNCA suba isso)
.env
.env.test
.env.production
.env.local

# Diretórios de build (se for usar React/TypeScript depois)
dist/
out/

